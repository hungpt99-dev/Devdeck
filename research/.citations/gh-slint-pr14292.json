    "followers_url": "https://api.github.com/users/NellowTCS/followers",
    "following_url": "https://api.github.com/users/NellowTCS/following{/other_user}",
    "gists_url": "https://api.github.com/users/NellowTCS/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/NellowTCS/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/NellowTCS/subscriptions",
    "organizations_url": "https://api.github.com/users/NellowTCS/orgs",
    "repos_url": "https://api.github.com/users/NellowTCS/repos",
    "events_url": "https://api.github.com/users/NellowTCS/events{/privacy}",
    "received_events_url": "https://api.github.com/users/NellowTCS/received_events",
