// Devdeck extension API — DRAFT WIT world for API major version 1.
// Stable worlds are versioned per major version: devdeck/api@1.0.0.
// Breaking changes require an ADR; deprecations last >= 2 minor versions.

package devdeck:api@1.0.0;

interface types {
  record extension-context {
    workspace-root: string,
    locale: string,
    extension-storage: string,
  }

  record tool-call {
    name: string,
    input-json: string,
    permission: string,
    risk: string,
  }

  variant permission {
    fs(paths: list<string>, write: bool),
    network(hosts: list<string>),
    process-spawn(programs: list<string>),
    env(names: list<string>),
    secrets(names: list<string>),
    clipboard,
    database,
    agent-access,
  }

  enum log-level { trace, debug, info, warn, error }

  record activation-event {
    kind: string,
    value: string,
  }
}

interface host {
  use types.{extension-context, tool-call, log-level};

  get-context: func() -> extension-context;
  log: func(level: log-level, message: string);
  notify: func(title-key: string, body-key: string);
  translate: func(key: string, args-json: string) -> string;
  run-tool: func(call: tool-call) -> result<string, string>;
  read-workspace-file: func(path: string) -> result<string, string>;
  write-workspace-file: func(path: string, contents: string) -> result<_, string>;
  get-setting: func(key: string) -> option<string>;
  request-approval: func(permission-name: string, reason-key: string) -> bool;
}

interface ui {
  // Safe declarative component vocabulary; no webviews, no arbitrary drawing.
  variant component {
    text(value: string),
    markdown(value: string),
    button(id: string, label-key: string),
    input(id: string, placeholder-key: string, value: string),
    list(items: list<string>),
    table(headers: list<string>, rows: list<list<string>>),
    form(fields: list<string>),
    chart(series: list<string>),
    diff(before: string, after: string),
    terminal-view(session-id: string),
  }

  render-panel: func(panel-id: string, root: component) -> result<_, string>;
  update-status-bar: func(item-id: string, text-key: string) -> result<_, string>;
}

world devdeck-extension {
  import host;
  import ui;
  use types.{activation-event};

  export activate: func(event: activation-event) -> result<_, string>;
  export deactivate: func() -> result<_, string>;
  export handle-command: func(id: string, args-json: string) -> result<string, string>;
  export handle-tool-call: func(name: string, input-json: string) -> result<string, string>;
}
